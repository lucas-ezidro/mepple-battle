# Required: PostgreSQL connection string (use the provider's pooled URL on Vercel)
DATABASE_URL=

# Optional: direct PostgreSQL connection for migrations; defaults to DATABASE_URL
DIRECT_URL=

# Required for game search; server-only Ludopedia catalog token
LUDOPEDIA_ACCESS_TOKEN=

# Optional: legacy account recovery credentials (Minhas Aplicacoes on Ludopedia)
LUDOPEDIA_APP_ID=
LUDOPEDIA_APP_KEY=

# Required for profile avatar uploads (Cloudinary dashboard credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
