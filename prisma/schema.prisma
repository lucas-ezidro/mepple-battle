generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String      @id @default(cuid())
  ludopediaUserId Int?        @unique
  name            String?
  username        String?     @unique
  email           String?
  fullName        String?
  avatarUrl       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  ranks           Rank[]
  followers       Follow[]    @relation("UserFollowers")
  following       Follow[]    @relation("UserFollowing")
  credential      Credential?
  sessions        Session[]
  rankLikes       RankLike[]
  comments        Comment[]
  commentLikes    CommentLike[]
}

model Credential {
  userId       String @id
  email        String @unique
  passwordHash String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  attempts  Int
  expiresAt DateTime

  @@index([expiresAt])
}

model Follow {
  followerId  String
  followingId String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

model Rank {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  year      Int?
  theme     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  games     RankGame[]
  likes     RankLike[]
  comments  Comment[]

  @@index([userId])
  @@index([createdAt, id])
}

model RankLike {
  userId String
  rankId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank   Rank @relation(fields: [rankId], references: [id], onDelete: Cascade)

  @@id([userId, rankId])
  @@index([rankId])
}

model Comment {
  id        String        @id @default(cuid())
  rankId    String
  userId    String
  parentId  String?
  body      String
  createdAt DateTime      @default(now())
  rank      Rank          @relation(fields: [rankId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("Replies", fields: [parentId, rankId], references: [id, rankId], onDelete: Cascade)
  replies   Comment[]     @relation("Replies")
  likes     CommentLike[]

  @@unique([id, rankId])
  @@index([rankId, parentId, createdAt, id])
  @@index([userId])
}

model CommentLike {
  userId    String
  commentId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
}

model RankGame {
  id       String @id @default(cuid())
  rankId   String
  rank     Rank   @relation(fields: [rankId], references: [id], onDelete: Cascade)
  position Int
  gameId   Int
  name     String
  thumb    String

  @@unique([rankId, position])
}
